{
  "name": "@savcm/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Agendamiento Virtual de Citas de Medicina General",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4",
    "multer": "^2.5.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "migration:generate": "ts-node -r tsconfig-paths/register ../node_modules/typeorm/cli.js migration:generate -d src/contexts/shared/infrastructure/database/migrations/data-source.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ../node_modules/typeorm/cli.js migration:run -d src/contexts/shared/infrastructure/database/migrations/data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register ../node_modules/typeorm/cli.js migration:revert -d src/contexts/shared/infrastructure/database/migrations/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/typeorm": "11.0.3",
    "bcryptjs": "^3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "16.4.7",
    "nodemailer": "^10.3.1",
    "pg": "8.11.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/express": "4.17.21",
    "@types/node": "22.15.3",
    "@types/nodemailer": "^8.0.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3"
  }
}
